# Copy to .env.local for `next dev`, or .env for the CLI scripts.
# Everything is optional in development: without these, JetJob uses an embedded
# PGlite database, a keyword stand-in for Jev, and writes emails to ./.outbox.

# TypeSafe AI. Required in production. https://typesafe.ai
TYPESAFE_API_KEY=
# TYPESAFE_DEFAULT_MODEL=jev-latest

# Postgres (Neon free tier works). Unset in dev = embedded PGlite in ./.data
DATABASE_URL=

# Resend for email. Unset in dev = HTML files in ./.outbox
RESEND_API_KEY=
EMAIL_FROM="JetJob <no-reply@yuki-ishihara.com>"

# Public URL used in email links
APP_URL=http://localhost:3000

# Long random string. Signs sessions, magic links and email feedback links.
JETJOB_SECRET=

# Vercel Cron sends this as a bearer token to /api/cron/*
CRON_SECRET=
